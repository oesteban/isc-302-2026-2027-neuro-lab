#!/usr/bin/env python3
"""Tissue segmentation of a skull-stripped T1w image, by Gaussian mixture.

The model knows nothing about brains. It sees a pile of numbers -- the intensity
of every voxel the skull-stripping step left behind -- and asks: if these came
from three Gaussians, which three?  That is the whole method.

The anatomy enters in exactly one line, where the fitted means are sorted. In a
T1-weighted image CSF is dark, white matter is bright, and grey matter sits
between them, so the darkest component *is* the CSF. Everything else here is
statistics.

Two estimators, and the difference is worth a few minutes of anyone's time.
The default is classical EM. `--vb` switches to the variational Bayesian
mixture, which puts a Dirichlet prior on the weights and is free to decide a
component is not needed. On this image, with a whole-brain mask, it uses that
freedom badly:

    EM    CSF/GM/WM = 209694 / 336150 / 268059    GM:WM = 1.25
    --vb  CSF/GM/WM =  87016 / 518965 / 207922    GM:WM = 2.50

A grey-to-white ratio of 2.5 is not anatomy, it is one broad Gaussian swallowing
two tissues. Turning the concentration prior up to 1e4 recovers EM's answer, but
only by forcing the weights to be equal, which is assuming the conclusion. The
real lesson is that neither estimator knows where the brain is: three Gaussians
on intensity alone cannot see that tissue comes in connected sheets.

That is what `--mrf` is for, and it is on by default. A Markov random field adds
a term rewarding agreement with neighbouring voxels, so a lone white-matter voxel
surrounded by grey matter is asked to justify itself and usually cannot. It is
the cheapest possible spatial prior and it is most of what separates this script
from a tool you would actually publish with.

Run it with `--mrf 0` to see what it is doing, and note that what you feed it
matters at least as much: on the raw image this script finds 468 mL of white
matter, and on the same image after `niimath -unifize` it finds 575 mL. The
second is the believable one.
"""
import argparse

import nibabel as nb
import numpy as np

p = argparse.ArgumentParser(
    description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
)
p.add_argument("input", help="skull-stripped T1w image (NIfTI)")
p.add_argument("output", help="discrete segmentation to write (NIfTI)")
p.add_argument("--probseg", help="also write the 4D posterior probabilities")
p.add_argument("--classes", type=int, default=3)
p.add_argument(
    "--subsample",
    type=int,
    default=100_000,
    help="voxels used to FIT the model (0 = all). Prediction always covers all.",
)
p.add_argument(
    "--vb",
    action="store_true",
    help="variational Bayes instead of EM (see the note at the top of this file)",
)
p.add_argument(
    "--mrf",
    type=float,
    default=0.7,
    metavar="BETA",
    help="strength of the spatial prior; 0 disables it (default: 0.7)",
)
p.add_argument(
    "--mrf-iterations", type=int, default=6, help="ICM sweeps over the volume (default: 6)"
)
p.add_argument("--seed", type=int, default=302)
args = p.parse_args()

img = nb.load(args.input)
data = np.asanyarray(img.dataobj, dtype="float32")

# The brain is whatever the skull-stripping left behind: it zeroed the rest.
brain = data > 0
x = data[brain].reshape(-1, 1)

# Rescale on robust percentiles. MRI intensity units are arbitrary and
# scanner-specific; without this the same script gives different answers on two
# scanners, which is exactly the kind of thing that makes a pipeline untrustworthy.
lo, hi = np.percentile(x, [1, 99])
x = np.clip((x - lo) / (hi - lo), 0.0, 1.0)

# Fit on a random subsample, predict on everything. 1.5M voxels is far more than
# three Gaussians need, and the fit/predict split is itself the point.
rng = np.random.default_rng(args.seed)
fit_x = (
    x
    if (not args.subsample or len(x) <= args.subsample)
    else x[rng.choice(len(x), args.subsample, replace=False)]
)

if args.vb:
    from sklearn.mixture import BayesianGaussianMixture as Mixture

    kw = {"weight_concentration_prior_type": "dirichlet_distribution"}
else:
    from sklearn.mixture import GaussianMixture as Mixture

    kw = {}

model = Mixture(
    n_components=args.classes,
    covariance_type="full",
    max_iter=500,
    random_state=args.seed,
    **kw,
)
model.fit(fit_x)
posterior = model.predict_proba(x)  # soft assignment, every voxel

# --- the one line of anatomy ------------------------------------------------
order = np.argsort(model.means_.ravel())  # darkest ... brightest
rank = np.empty_like(order)
rank[order] = np.arange(1, args.classes + 1)  # 1=CSF  2=GM  3=WM
# ---------------------------------------------------------------------------

assignment = posterior.argmax(axis=1)

if args.mrf > 0:
    # A Potts prior, minimised by iterated conditional modes.
    #
    # The mixture treats every voxel as an independent draw, which is the thing
    # wrong with it: brains are not a fine mist of tissue types, they are
    # connected sheets. So add a term that rewards agreeing with your
    # neighbours, and re-decide each voxel given the labels around it:
    #
    #     score(voxel = k) = log P(intensity | k) + beta * (neighbours labelled k)
    #
    # beta is what a voxel's own intensity is worth against the company it keeps.
    # Too small and nothing changes; too large and the volume collapses to one
    # label. It is a knob, and being explicit about it is more honest than the
    # alternative, which is pretending segmentation has no knobs.
    from scipy import ndimage

    neighbourhood = ndimage.generate_binary_structure(3, 1).astype("float32")
    neighbourhood[1, 1, 1] = 0  # a voxel is not its own neighbour

    data_term = np.log(posterior + 1e-12)
    volume = np.zeros(data.shape, dtype="uint8")

    for sweep in range(args.mrf_iterations):
        volume[brain] = assignment + 1
        scores = np.empty_like(data_term)
        for k in range(args.classes):
            agree = ndimage.convolve(
                (volume == k + 1).astype("float32"), neighbourhood, mode="constant"
            )
            scores[:, k] = data_term[:, k] + args.mrf * agree[brain]
        updated = scores.argmax(axis=1)
        changed = int((updated != assignment).sum())
        assignment = updated
        print(f"  MRF sweep {sweep + 1}: {changed} voxels changed label")
        if changed == 0:
            break

labels = np.zeros(data.shape, dtype="uint8")
labels[brain] = rank[assignment]

# A fresh header on purpose: inheriting the input's would carry its
# scl_slope/scl_inter onto integer labels and quietly rescale them.
out = nb.Nifti1Image(labels, img.affine)
out.set_data_dtype(np.uint8)
out.header.set_zooms(img.header.get_zooms()[:3])
out.to_filename(args.output)

print(f"Wrote {args.output}")
means = model.means_.ravel()[order]
weights = model.weights_[order]
for name, k in zip(("CSF", "GM", "WM"), range(1, args.classes + 1)):
    n = int((labels == k).sum())
    print(f"  {name:<3s} mean={means[k - 1]:.3f} weight={weights[k - 1]:.3f} {n:>9d} voxels")

if weights.min() < 0.02:
    print(
        "\n  WARNING: one component holds almost no voxels. If you passed --vb, "
        "the\n  Dirichlet prior pruned it; the default (EM) does not do that."
    )

if args.probseg:
    probs = np.zeros(data.shape + (args.classes,), dtype="float32")
    probs[brain] = posterior[:, order]
    pv = nb.Nifti1Image(probs, img.affine)
    pv.header.set_zooms(img.header.get_zooms()[:3] + (1.0,))
    pv.to_filename(args.probseg)
    print(f"Wrote {args.probseg}")
