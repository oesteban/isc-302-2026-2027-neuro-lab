#!/usr/bin/env python3
"""N4 bias field correction.

An MRI scanner does not measure the same intensity for the same tissue in two
different parts of the head. The receive coil is closer to some of it, so the
image carries a smooth multiplicative drift on top of the anatomy, bright here
and dim there. Radiologists look straight past it. A histogram cannot: to a
model that only sees intensities, drifted white matter and undrifted grey matter
are the same number, which is exactly the confusion the next step has to make.

N4 estimates that drift as a smooth field, in the log domain where multiplication
becomes addition, by sharpening the intensity histogram: the field that makes the
histogram peakiest is the one that was blurring it. Then it divides it out.

The field is fitted on a downsampled copy, because it is smooth by construction
and does not need full resolution to be estimated, and then applied at full
resolution. That is a factor of tens in runtime for no loss worth measuring.

A caution that is easy to skip and expensive to learn. The default is two
fitting levels, not the four you will see in most examples, because a more
flexible field is not a better one. Measured on this image, segmenting after
N4 and counting tissue:

    no N4          CSF 361  GM 618  WM 468 mL    GM:WM = 1.32
    2 levels       CSF 363  GM 619  WM 465 mL    GM:WM = 1.33
    4 levels       CSF 270  GM 758  WM 419 mL    GM:WM = 1.81

At four levels the spline has enough freedom to treat the grey-white boundary
itself as bias and smooth it away, and 140 mL of white matter becomes grey. At
two it leaves this image almost untouched, which is the correct answer here:
this acquisition has very little bias to remove. A correction that does nothing
is not a wasted step. A correction that does too much is worse than none.
"""
import argparse

import SimpleITK as sitk

p = argparse.ArgumentParser(
    description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
)
p.add_argument("input", help="image to correct (NIfTI)")
p.add_argument("output", help="corrected image to write (NIfTI)")
p.add_argument("-m", "--mask", help="restrict the fit to this mask (NIfTI)")
p.add_argument("--field", help="also write the estimated bias field")
p.add_argument(
    "--shrink", type=int, default=4, help="downsampling factor for the fit (default: 4)"
)
p.add_argument(
    "--levels",
    type=int,
    default=2,
    help="resolution levels to fit over. More levels means a more flexible field, "
    "which is not the same as a better one (default: 2)",
)
p.add_argument(
    "--iterations",
    type=int,
    default=50,
    help="iterations per resolution level (default: 50)",
)
args = p.parse_args()

image = sitk.ReadImage(args.input, sitk.sitkFloat32)

if args.mask:
    mask = sitk.ReadImage(args.mask, sitk.sitkUInt8)
else:
    # Without a mask N4 fits the field over the air as well, which is noise with
    # no tissue in it. Otsu is enough to say "head" from "not head".
    mask = sitk.OtsuThreshold(image, 0, 1, 200)

shrunk_image = sitk.Shrink(image, [args.shrink] * image.GetDimension())
shrunk_mask = sitk.Shrink(mask, [args.shrink] * mask.GetDimension())

corrector = sitk.N4BiasFieldCorrectionImageFilter()
corrector.SetMaximumNumberOfIterations([args.iterations] * args.levels)
corrector.Execute(shrunk_image, shrunk_mask)

# Fitted small, applied large: ask for the field itself at full resolution.
log_field = corrector.GetLogBiasFieldAsImage(image)
corrected = image / sitk.Exp(log_field)

sitk.WriteImage(corrected, args.output)
print(f"Wrote {args.output}")
print(
    f"  fitted on a 1/{args.shrink} copy, {args.iterations} iterations "
    f"x {args.levels} levels"
)

if args.field:
    sitk.WriteImage(sitk.Exp(log_field), args.field)
    print(f"Wrote {args.field}")
